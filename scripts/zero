#!/bin/sh
# zero — Go CLI (cmd/zero). Builds on demand, then runs the binary.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/bin/zero"
need_build=0
[ -x "$BIN" ] || need_build=1
if [ "$need_build" -eq 0 ] &&
   [ -n "$(find "$ROOT/cmd" "$ROOT/internal" \( -name '*.go' -o -name 'policy.yaml' \) -newer "$BIN" 2>/dev/null)" ]; then
  need_build=1
fi
if [ "$need_build" -eq 1 ]; then
  (cd "$ROOT" && go build -o "$BIN" ./cmd/zero)
fi
exec "$BIN" "$@"
