# Z3R0 dev image (F11): golang + git + tools. Base and tools pinned by digest.
# Tools come from uniget (https://uniget.dev) images: each is a layer of
# bin/, share/, etc/ meant to be copied to /usr/local. Bump with `uniget describe <tool>`.
# opencode runs inside the sandbox (terminal UI over ssh, web UI through the forward; ADR 0048).
FROM ghcr.io/uniget-org/tools/opencode:2.2.6@sha256:5e0d67ecab7429faf809abc904a53f008b91ac77bf30e2bb8270f9817ad36ea9 AS opencode
FROM ghcr.io/uniget-org/tools/glab:1.128.0@sha256:e45f834a8801d5aae77950cfd1e3733dbd90049f3f62056338c8e4cfdabfde5a AS glab
FROM ghcr.io/uniget-org/tools/ripgrep:15.2.0@sha256:067c5fa538ad254643b5e44cdb6a254b748353e7f7364f61d79bf39eece85b81 AS ripgrep
# GitHub Copilot CLI for `zero copilot` (ADR 0050): one binary, no Node.
FROM ghcr.io/uniget-org/tools/copilot:1.0.116@sha256:57da4696f7c65a6dc325a40509fbbdeb8f709ba2ac6a772687f9f47c0203e45c AS copilot
# Claude Code for `zero claude` (ADR 0052): one binary, no Node.
FROM ghcr.io/uniget-org/tools/claude:2.1.332@sha256:20749e1942b0312a77dfa0f964f8eab08612ca12a1f42763ffb92e37a7c1aac7 AS claude

FROM docker.io/library/golang:1.25@sha256:699337d620559a59b4a2bb298ad59611e535d2ee755a34cf2d2a98f37578dc80
COPY --from=opencode / /usr/local/
COPY --from=glab / /usr/local/
COPY --from=ripgrep / /usr/local/
COPY --from=copilot / /usr/local/
COPY --from=claude / /usr/local/
RUN opencode --version && glab --version && rg --version && copilot --version && claude --version \
    && test -x /usr/local/libexec/claude/node_modules/@anthropic-ai/claude-code/bin/claude.exe
# C09: `sandbox exec` login shell resets PATH; re-add go. GOPATH under writable HOME (/sandbox).
RUN printf 'export PATH=/usr/local/go/bin:$PATH\nexport GOPATH=$HOME/go\n' > /etc/profile.d/z3r0-go.sh
# VS Code server for `zero code` (#107), where Remote-SSH looks for it in the
# sandbox HOME (/go, uid 1000). Must equal the local VS Code commit
# (`code --version`, second line); otherwise VS Code downloads its own as before.
# Bump: curl https://update.code.visualstudio.com/api/versions/commit:<commit>/{server-linux-x64,cli-alpine-x64}/stable
ARG VSCODE_COMMIT=c4453f8ea430795f941c1b2ff6c9321135a74a02
ARG VSCODE_SERVER_SHA256=86a64e07f25c25e52e0d702d9d5fad4927cca86380f55283f4ef87e87772f0c3
ARG VSCODE_CLI_SHA256=14686fb8f61038097d5d65af0c1a50449f3d34817c3e2724971916a9be27b55d
RUN set -eu; d=/go/.vscode-server; s=$d/cli/servers/Stable-$VSCODE_COMMIT; \
    u=https://vscode.download.prss.microsoft.com/dbazure/download/stable/$VSCODE_COMMIT; \
    mkdir -p $s/server; \
    curl -fsSL -o /tmp/server.tgz $u/vscode-server-linux-x64.tar.gz; \
    curl -fsSL -o /tmp/cli.tgz $u/vscode_cli_alpine_x64_cli.tar.gz; \
    printf '%s  /tmp/server.tgz\n%s  /tmp/cli.tgz\n' $VSCODE_SERVER_SHA256 $VSCODE_CLI_SHA256 | sha256sum -c; \
    tar -xzf /tmp/server.tgz -C $s/server --strip-components=1; \
    tar -xzf /tmp/cli.tgz -C /tmp code; mv /tmp/code $d/code-$VSCODE_COMMIT; \
    printf '["Stable-%s"]' $VSCODE_COMMIT > $d/cli/servers/lru.json; \
    rm /tmp/server.tgz /tmp/cli.tgz; chown -R 1000:1000 $d
# C12: no setuid/setgid binaries.
RUN find / -xdev -perm /6000 -type f -exec chmod ug-s {} + ; test -z "$(find / -xdev -perm /6000 -type f)"
